<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background. The gradient continues the artwork's own diagonal
    (bright blue at the top-left falling to deep navy), so the ring of
    background showing around the foreground reads as part of the same image.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#003B97"
                android:centerColor="#002766"
                android:endColor="#001740" />
        </aapt:attr>
    </path>
</vector>
